{
  "Règle decide(ctx)": {
    "prefix": "decide",
    "description": "Squelette d'une règle Portfolio Assistant",
    "body": [
      "def decide(ctx):",
      "    h = ctx.history                      # cours jusqu'à la date de décision, jamais après",
      "    if len(h) < ${1:130}:",
      "        return None                      # pas assez d'historique : rester en liquidités",
      "    ${2:# calculer les poids}",
      "    return {${3:t: 1 / len(h.columns) for t in h.columns}}"
    ]
  },
  "Momentum : les k meilleurs": {
    "prefix": "pa-momentum",
    "body": [
      "def decide(ctx):",
      "    h = ctx.history",
      "    if len(h) < ${1:253}:",
      "        return None",
      "    perf = h.iloc[-${2:22}] / h.iloc[-${1:253}] - 1   # 12 mois, sans le dernier mois",
      "    best = perf.sort_values().index[-${3:3}:]",
      "    return {t: 1 / len(best) for t in best}"
    ]
  },
  "Volatilité cible": {
    "prefix": "pa-volcible",
    "body": [
      "import numpy as np",
      "",
      "",
      "def decide(ctx):",
      "    h = ctx.history",
      "    if len(h) < 64:",
      "        return None",
      "    r = h.pct_change().iloc[-63:].mean(axis=1)",
      "    vol = r.std() * np.sqrt(252)",
      "    exposition = min(1.0, ${1:0.10} / vol) if vol > 0 else 1.0",
      "    return {t: exposition / len(h.columns) for t in h.columns}"
    ]
  },
  "Parité de risque": {
    "prefix": "pa-parite",
    "body": [
      "def decide(ctx):",
      "    h = ctx.history",
      "    if len(h) < ${1:64}:",
      "        return None",
      "    vol = h.pct_change().iloc[-${1:64}:].std()",
      "    inverse = 1 / vol",
      "    return (inverse / inverse.sum()).to_dict()"
    ]
  }
}
